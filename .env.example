# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Pasarela de Pagos Bold
NEXT_PUBLIC_BOLD_IDENTITY_KEY=your-bold-identity-key
BOLD_IDENTITY_KEY=your-bold-identity-key
BOLD_SECRET_KEY=your-bold-secret-key

# Correos transaccionales con Resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=EDDIP <notificaciones@your-domain.com>

# URL pública del sitio
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Supabase service role (solo servidor)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
